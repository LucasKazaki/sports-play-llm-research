{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConceptExplanationV1",
  "description": "Inspectable explanation output contract. This structure does not prove chess legality, engine execution, factual concept truth, or human-quality explanation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["abstain", "verdict", "confidence", "concepts", "engine_evidence_refs", "commentary_evidence_refs"],
  "properties": {
    "abstain": {"type": "boolean"},
    "verdict": {"enum": ["abstain", "concept_explanation"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "concepts": {"type": "array", "items": {"enum": ["king_safety", "material", "development", "center", "piece_activity", "pawn_structure", "space", "tactical_threat", "endgame_transition"]}, "uniqueItems": true},
    "engine_evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "commentary_evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "move_summary": {"type": "string", "minLength": 1},
    "primary_concepts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["concept", "claim", "evidence_refs"],
        "properties": {
          "concept": {"enum": ["king_safety", "material", "development", "center", "piece_activity", "pawn_structure", "space", "tactical_threat", "endgame_transition"]},
          "claim": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {
      "if": {"properties": {"abstain": {"const": false}}, "required": ["abstain"]},
      "then": {
        "properties": {
          "verdict": {"const": "concept_explanation"},
          "primary_concepts": {"minItems": 1},
          "limitations": {"minItems": 1}
        },
        "required": ["move_summary", "primary_concepts", "limitations"]
      }
    },
    {
      "if": {"properties": {"abstain": {"const": true}}, "required": ["abstain"]},
      "then": {"properties": {"verdict": {"const": "abstain"}}}
    }
  ]
}
