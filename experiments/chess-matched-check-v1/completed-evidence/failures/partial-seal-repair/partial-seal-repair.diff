+def failed_outcome_ledger(worker_out,reason):
+    """Separate failure accounting, never overwrite/reseal a partial raw tree."""
+    cases=planned_ids()
+    found,conflicts,notes={},{},[]
+    journal=worker_out/"journal.jsonl"
+    if journal.exists():
+        with journal.open(encoding="utf-8") as stream:
+            for index,line in enumerate(stream):
+                try:
+                    row=json.loads(line)
+                    if (not isinstance(row,dict) or row.get("case_id") not in cases or
+                        row.get("status") not in ("completed","truncated","error","not_run") or
+                        not isinstance(row.get("text"),str)):
+                        raise ValueError("invalid journal outcome")
+                except (ValueError,TypeError):
+                    notes.append({"journal_line":index,"invalid_or_partial":True})
+                    continue
+                case=row["case_id"]
+                if case in found:
+                    conflicts[case]=True
+                else:
+                    found[case]=row
+    outcomes=[]
+    for index,case in enumerate(cases):
+        if case in conflicts:
+            outcomes.append({"case_id":case,"status":"error","text":"",
+                "actual_call_status":"unresolved_conflicting_journal_outcomes"})
+        elif case in found:
+            outcomes.append(found[case])
+        elif (worker_out/(f"prepared-{index:02d}.json")).exists():
+            outcomes.append({"case_id":case,"status":"error","text":"",
+                "actual_call_status":"unknown_after_worker_interruption"})
+        else:
+            outcomes.append({"case_id":case,"status":"not_run","text":""})
+    partial_files={}
+    for name in ("raw/raw.json","raw/raw.json.tmp","raw/seal.json","raw/seal.json.tmp","journal.jsonl"):
+        path=worker_out/name
+        if path.is_file():
+            partial_files[name]=boundary.sha(path)
+    target=worker_out.parent/"failed-outcome-ledger.json"
+    boundary.fresh(target,{"schema":"chess.matched-check.failed-outcomes.v1","planned":64,
+        "rows":outcomes,"reason":reason,"partial_files_sha256":partial_files,
+        "recovery_notes":notes,"status":"FAILED","quality_completion":False,
+        "limits":"File-only failure accounting, not a raw seal or permission to score/replay. No labels opened."})
+    return boundary.sha(target)
+
+
