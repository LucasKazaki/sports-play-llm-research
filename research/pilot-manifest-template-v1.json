{
  "schema_version": "playground-pilot-manifest-template-v1",
  "manifest_status": "unpopulated_metadata_template",
  "warning": "Template only: contains no candidate media, rights grant, acquisition authorization, annotations, or real-soccer observations.",
  "pilot_constraints": {
    "maximum_clip_count": 50,
    "minimum_duration_s": 5.0,
    "maximum_duration_s": 10.0,
    "minimum_independent_match_groups_target": 10,
    "maximum_clips_per_match_target": 5,
    "minimum_unanswerable_control_fraction": 0.2,
    "double_annotation_policy": "all_pilot_items"
  },
  "rights_gate": {
    "source_path_selected_in_writing": false,
    "rights_record_saved": false,
    "privacy_and_partner_constraints_confirmed": false,
    "candidate_manifest_reviewed": false,
    "acquisition_method_approved": false,
    "storage_access_retention_named": false,
    "annotators_and_adjudicator_named": false,
    "acquisition_authorized": false
  },
  "rights_record_template": {
    "rights_record_id": null,
    "owner_or_licensor": null,
    "owner_authority_basis": null,
    "source_url_or_local_record": null,
    "effective_date": null,
    "access_date": null,
    "permitted_uses": [],
    "prohibited_uses": [],
    "api_policy": null,
    "release_policy": null,
    "storage_location": null,
    "authorized_people": [],
    "retention_and_deletion_rule": null
  },
  "split_contract": {
    "primary_group_field": "match_id",
    "fallback_group_field": "source_id",
    "near_duplicate_play_group_field": "play_group_id",
    "rule": "No source, match, or near-duplicate play group may cross splits.",
    "split_assignment_stage": "after candidate eligibility review and before annotation or model evaluation"
  },
  "sampling_contract": {
    "target_clip_count": 50,
    "provisional_primary_question_type_targets": {
      "restart-identification": 8,
      "progression-trajectory": 10,
      "temporal-order": 8,
      "player-role": 8,
      "causal-evidence": 8,
      "counterfactual-control": 8
    },
    "control_target": "At least 10 of 50 primary items are intentionally unanswerable or invalid controls; controls remain hidden from models.",
    "selection_order": [
      "rights and privacy eligibility",
      "5-10 second boundary feasibility",
      "independent match/source diversity",
      "question-type and answerability quota",
      "viewpoint, phase-of-play, occlusion, and difficulty diversity"
    ],
    "anti_cherry_pick_rule": "Log every screened candidate and exclusion reason before annotation; do not replace hard clips based on model output."
  },
  "required_clip_fields": [
    "clip_id",
    "source_id",
    "match_id",
    "play_group_id",
    "source_owner",
    "rights_record_id",
    "source_uri_private",
    "candidate_start_time_s",
    "candidate_end_time_s",
    "expected_duration_s",
    "selection_stratum",
    "planned_primary_question_type",
    "planned_answerability_role",
    "privacy_flags",
    "commentary_present",
    "scoreboard_present",
    "api_policy",
    "release_policy",
    "eligibility_status",
    "exclusion_reason",
    "proposed_split",
    "sha256_after_acquisition",
    "acquired_at",
    "acquired_by",
    "annotation_status"
  ],
  "clip_row_template": {
    "clip_id": null,
    "source_id": null,
    "match_id": null,
    "play_group_id": null,
    "source_owner": null,
    "rights_record_id": null,
